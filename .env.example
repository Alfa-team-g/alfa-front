# Configuração do agendamento (cron)
# Padrão: a cada 6 horas
CRON_SCHEDULE="0 */6 * * *"

# Firebase Admin (Cloud Firestore)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_LINE_1\nYOUR_KEY_LINE_2\n-----END PRIVATE KEY-----\n"
GITHUB_ACTIONS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_OWNER=Alfa-team-g
GITHUB_REPO_NAME=alfa-back
GITHUB_WORKFLOW_ID=screper-livelo.yml
GITHUB_WORKFLOW_REF=master
